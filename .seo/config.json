{
	"version": "1.0.0",
	"site": {
		"url": "https://bearboo-eight.vercel.app",
		"gscProperty": "https://bearboo-eight.vercel.app/",
		"locale": "en-US",
		"country": "us"
	},
	"output": {
		"kind": "cms",
		"contentDir": "prisma",
		"slugPattern": "{slug}"
	},
	"corpus": {

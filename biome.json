					"ondragenter",
					"onpopstate",
					"onmousewheel",
					"onemptied",
					"onbeforeunload",
					"onplaying",
					"onvolumechange"
				]
			},
			"linter": {
				"rules": {
					"correctness": { "noUnusedVariables": "warn" },
					"suspicious": { "noExplicitAny": "off" }
				}
			}
		},
		{
			"includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
			"linter": {
				"rules": {
					"complexity": { "noArguments": "error" },

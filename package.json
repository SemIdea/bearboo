{
	"name": "next-app-template",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && prisma migrate deploy && next build",
		"start": "next start",
		"postinstall": "prisma generate",
		"test": "vitest run --reporter verbose",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"lint": "biome check --write .",
		"lint:staged": "lint-staged",
		"prepare": "husky",
		"docker:dev": "docker compose -f docker-compose-dev.yml up --build",
		"docker:start": "docker compose -f docker-compose.yml up --build",
		"db:seed": "node --env-file=.env prisma/seed.ts",
		"db:seed:pagination-test": "node --env-file=.env prisma/seed-pagination-test.ts"
	},
	"prisma": {
		"seed": "node --env-file=.env prisma/seed.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.0",
		"@prisma/client": "^6.5.0",
		"@prisma/extension-accelerate": "^1.2.1",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tabs": "^1.1.12",
		"@react-aria/ssr": "3.9.7",
		"@react-aria/visually-hidden": "3.8.18",
		"@tanstack/react-query": "^5.66.7",
		"@tanstack/react-query-devtools": "^5.66.7",
		"@trpc/client": "^11.0.0-rc.789",
		"@trpc/next": "^11.0.0-rc.789",
		"@trpc/react-query": "^11.0.0-rc.789",
		"@trpc/server": "^11.0.0-rc.789",
		"@uiw/react-md-editor": "^4.0.7",
		"bcrypt": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.0.1",
		"framer-motion": "11.13.1",
		"intl-messageformat": "^10.5.0",
		"ioredis": "^6.0.0",
		"lucide-react": "^0.514.0",
		"next": "^16.2.10",
		"next-themes": "^0.4.4",
		"nodemailer": "^9.0.3",
		"prisma": "^6.5.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "^7.61.1",
		"react-icons": "^5.5.0",
		"superjson": "^2.2.2",
		"tailwind-merge": "^3.3.0",
		"tailwindcss-animate": "^1.0.7",
		"uuid": "^14.0.1",
		"vite-tsconfig-paths": "^5.1.4",
		"zod": "^4.0.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@react-types/shared": "3.25.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^20.19.0",
		"@types/nodemailer": "^6.4.17",
		"@types/react": "18.3.3",
		"@types/react-dom": "18.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"postcss": "8.5.16",
		"prettier": "3.3.3",
		"prisma-mock": "^1.1.0",
		"tailwind-variants": "0.1.20",
		"tailwindcss": "^4.1.11",
		"testcontainers": "^12.1.0",
		"typescript": "^5.8.3",
		"vite": "^8.1.3",
		"vitest": "^4.1.9"
	},
	"overrides": {
		"postcss": "8.5.16",
		"mdast-util-to-hast": "13.2.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html,gql,graphql}": "biome check --write --no-errors-on-unmatched"
	}
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

model User {
  id                String              @id
  email             String              @unique
  password          String
  name              String
  bio               String?
  role              Role                @default(AUTHOR)
  sessions          Session[]
  Post              Post[]
  comments          Comment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  verified          Boolean             @default(false)
  reviewComments    PostReviewComment[]
  media             Media[]
}

model Session {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  accessToken          String
  refreshToken         String
  previousRefreshToken String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Post {
  id             String              @id
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  title          String
  content        String
  slug           String              @unique
  previousSlug   String?             @unique
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  status         PostStatus          @default(PUBLISHED)
  scheduledAt    DateTime?
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id])
  coverImageUrl  String?
  viewCount      Int                 @default(0)
  postTags       PostTag[]
  comments       Comment[]
  reviewComments PostReviewComment[]
  postViews      PostView[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

enum ReferrerBucket {
  DIRECT
  SEARCH
  SOCIAL
  OTHER
}

model PostView {
  id             String         @id
  postId         String
  post           Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  referrerBucket ReferrerBucket
  userAgent      String
  createdAt      DateTime       @default(now())

  @@index([postId, createdAt])
  @@index([createdAt])
}

enum ReviewCommentType {
  APPROVAL
  REJECTION
}

model PostReviewComment {
  id         String            @id
  postId     String
  post       Post              @relation(fields: [postId], references: [id])
  reviewerId String
  reviewer   User              @relation(fields: [reviewerId], references: [id])
  type       ReviewCommentType
  content    String?
  createdAt  DateTime          @default(now())
}

model Media {
  id           String   @id
  url          String
  storageKey   String
  filename     String
  mimeType     String
  size         Int
  altText      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

model Category {
  id    String @id
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Tag {
  id       String    @id
  name     String    @unique
  slug     String    @unique
  postTags PostTag[]
}

model PostTag {
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model Comment {
  id        String   @id
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  userId    String
  used      Boolean  @default(false)
}

model ResetToken {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  userId    String
  used      Boolean  @default(false)
}
